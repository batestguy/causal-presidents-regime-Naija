{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causal-presidents.local/schema/intent_eval.schema.json",
  "title": "Intent gate evaluation (Stage 9)",
  "type": "object",
  "required": [
    "schema_version",
    "vintage",
    "generated_at",
    "generator",
    "specs",
    "corpus",
    "rules",
    "held_out",
    "published_set",
    "known_gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "layer": { "type": "string" },
    "vintage": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["script", "spec", "eval_spec"],
      "properties": {
        "script": { "type": "string" },
        "spec": { "type": "string" },
        "eval_spec": { "type": "string" },
        "git_sha": { "type": ["string", "null"] }
      }
    },
    "specs": {
      "type": "object",
      "required": ["gate", "eval"],
      "properties": {
        "gate": {
          "type": "object",
          "required": ["path", "sha256", "frozen_at"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "frozen_at": { "type": ["string", "null"] }
          }
        },
        "eval": {
          "type": "object",
          "required": ["path", "sha256", "frozen_at"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "frozen_at": { "type": ["string", "null"] }
          }
        }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["path", "sha256", "chunks", "vintage"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "chunks": { "type": "integer", "minimum": 1 },
        "vintage": { "type": "string" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "priority", "intent"],
        "properties": {
          "id": { "type": "string" },
          "priority": { "type": "integer" },
          "intent": { "enum": ["answerable", "out_of_scope", "refusal_with_reason"] },
          "implements": { "type": "string" }
        }
      }
    },
    "held_out": {
      "type": "object",
      "required": ["counts", "metrics", "gates", "per_family", "questions"],
      "properties": {
        "what_this_is": { "type": "string" },
        "counts": { "type": "object" },
        "metrics": {
          "type": "object",
          "required": [
            "n_questions",
            "intent_accuracy",
            "out_of_scope_refusal",
            "answerable_not_refused",
            "refusal_route_resolved",
            "refusal_reason_cited"
          ],
          "properties": {
            "n_questions": { "type": "integer", "minimum": 1 },
            "intent_accuracy": { "type": "number" },
            "out_of_scope_refusal": { "type": "number" },
            "answerable_not_refused": { "type": "number" },
            "refusal_route_resolved": { "type": "number" },
            "refusal_reason_cited": { "type": "number" },
            "route_matches_gold": { "type": "number" }
          }
        },
        "gates": { "$ref": "#/$defs/gates" },
        "per_family": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["family", "n", "intent_accuracy", "misses"],
            "properties": {
              "family": { "type": "string" },
              "n": { "type": "integer", "minimum": 1 },
              "intent_accuracy": { "type": "number" },
              "misses": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/held_out_question" }
        }
      }
    },
    "published_set": {
      "type": "object",
      "required": ["path", "counts", "metrics", "gates", "questions"],
      "properties": {
        "what_this_is": { "type": "string" },
        "path": { "type": "string" },
        "counts": { "type": "object" },
        "metrics": {
          "type": "object",
          "required": [
            "n_questions",
            "out_of_scope_refusal",
            "answerable_not_refused",
            "answerable_recall_at_5",
            "refusal_route_matches_citation",
            "refusal_reason_cited"
          ],
          "properties": {
            "n_questions": { "type": "integer", "minimum": 1 },
            "out_of_scope_refusal": { "type": "number" },
            "answerable_not_refused": { "type": "number" },
            "answerable_recall_at_5": { "type": "number" },
            "refusal_route_matches_citation": { "type": "number" },
            "refusal_reason_cited": { "type": "number" },
            "retrieval": { "type": "string" },
            "scope_chunks": { "type": "array", "items": { "type": "string" } }
          }
        },
        "gates": { "$ref": "#/$defs/gates" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/published_question" }
        }
      }
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scope_clause", "status"],
        "properties": {
          "id": { "type": "string" },
          "scope_clause": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["target", "measured", "met"],
        "properties": {
          "target": { "type": "number" },
          "measured": { "type": ["number", "null"] },
          "met": { "type": ["boolean", "null"] }
        }
      }
    },
    "held_out_question": {
      "type": "object",
      "required": [
        "id",
        "family",
        "question",
        "expected_intent",
        "intent",
        "rule_id",
        "route",
        "route_status",
        "correct"
      ],
      "properties": {
        "id": { "type": "string" },
        "family": { "type": "string" },
        "question": { "type": "string" },
        "expected_intent": { "enum": ["answerable", "out_of_scope", "refusal_with_reason"] },
        "intent": { "enum": ["answerable", "out_of_scope", "refusal_with_reason"] },
        "rule_id": { "type": ["string", "null"] },
        "route": { "type": ["string", "null"] },
        "route_status": { "enum": ["pinned", "unresolved", "not_applicable"] },
        "reason": { "type": "string" },
        "expected_gap": { "type": ["string", "null"] },
        "gold": { "type": ["string", "null"] },
        "gold_scored": { "type": "boolean" },
        "correct": { "type": "boolean" },
        "route_matches_gold": { "type": "boolean" },
        "needle": { "type": "string" },
        "needle_found": { "type": "boolean" }
      }
    },
    "published_question": {
      "type": "object",
      "required": ["id", "type", "question", "intent", "route", "route_status", "first_gold_rank"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["answerable", "out_of_scope", "refusal_with_reason"] },
        "question": { "type": "string" },
        "intent": { "enum": ["answerable", "out_of_scope", "refusal_with_reason"] },
        "rule_id": { "type": ["string", "null"] },
        "route": { "type": ["string", "null"] },
        "route_status": { "enum": ["pinned", "unresolved", "not_applicable"] },
        "expected_refusal_cite": { "type": ["string", "null"] },
        "route_matches_cite": { "type": "boolean" },
        "carries_a_needle": { "type": "boolean" },
        "first_gold_rank": { "type": ["integer", "null"] },
        "retrieved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chunk_id", "score"],
            "properties": {
              "chunk_id": { "type": "string" },
              "score": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
