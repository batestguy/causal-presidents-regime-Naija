{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causal-presidents/registry/schema/series_index.schema.json",
  "title": "Outcome-series figure index",
  "description": "One panel per outcome card, drawn from the analytical base. The index carries the counts, the span, the Stage 3 status, the definition breaks, the caption and the figure's byte count, so a reader (and a verifier) can check the picture against the series without opening R.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stage", "layer", "vintage", "generated_at", "generator", "spec",
    "verifier", "input", "window", "counts", "marks", "outcomes", "notes"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stage": { "type": "string" },
    "layer": { "type": "string" },
    "vintage": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "git_sha"],
      "properties": {
        "script": { "type": "string", "const": "analysis/R/07_series_figures.R" },
        "git_sha": { "type": ["string", "null"] }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "md5", "version"],
      "properties": {
        "path": { "type": "string" },
        "md5": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "version": { "type": "integer" }
      }
    },
    "verifier": { "type": "string" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "fact_table", "native_table", "metric_dimension",
                   "definition_break_table", "outcomes_spec", "outcomes_spec_md5"],
      "properties": {
        "database": { "type": "string" },
        "fact_table": { "type": "string" },
        "native_table": { "type": "string" },
        "metric_dimension": { "type": "string" },
        "definition_break_table": { "type": "string" },
        "outcomes_spec": { "type": "string" },
        "outcomes_spec_md5": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      }
    },
    "window": { "$ref": "#/$defs/window" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomes", "drawable", "flagged", "with_definition_break", "spine_rows"],
      "properties": {
        "outcomes": { "type": "integer", "minimum": 1 },
        "drawable": { "type": "integer", "minimum": 0 },
        "flagged": { "type": "integer", "minimum": 0 },
        "with_definition_break": { "type": "integer", "minimum": 0 },
        "spine_rows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "interpolated", "unobserved"],
          "properties": {
            "observed": { "type": "integer", "minimum": 0 },
            "interpolated": { "type": "integer", "minimum": 0 },
            "unobserved": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "marks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "interpolated", "unobserved", "min_shaded_run_months"],
      "properties": {
        "observed": { "type": "string" },
        "interpolated": { "type": "string" },
        "unobserved": { "type": "string" },
        "min_shaded_run_months": { "type": "integer", "minimum": 1 }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "label", "short", "domain", "unit", "direction", "source", "native_frequency",
          "quality_status", "drawable", "window", "observations", "native_in_window",
          "first_observed", "last_observed", "definition_breaks", "caption", "figure"
        ],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "short": { "type": "string" },
          "domain": { "type": ["string", "null"] },
          "unit": { "type": "string" },
          "direction": { "type": ["string", "null"], "enum": ["up", "down", null] },
          "source": { "type": ["string", "null"] },
          "native_frequency": { "type": "string" },
          "quality_status": { "type": "string", "enum": ["ok", "flagged", "empty"] },
          "drawable": { "type": "boolean" },
          "window": { "$ref": "#/$defs/window" },
          "observations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observed", "interpolated", "unobserved"],
            "properties": {
              "observed": { "type": "integer", "minimum": 0 },
              "interpolated": { "type": "integer", "minimum": 0 },
              "unobserved": { "type": "integer", "minimum": 0 }
            }
          },
          "native_in_window": { "type": "integer", "minimum": 0 },
          "first_observed": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "last_observed": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "definition_breaks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "name", "note"],
              "properties": {
                "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
                "name": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          },
          "caption": { "type": "string", "minLength": 20 },
          "figure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes"],
            "properties": {
              "path": { "type": "string", "pattern": "^registry/series/[0-9]{4}-[0-9]{2}-[0-9]{2}/figures/[a-z0-9_]+\\.svg$" },
              "bytes": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "last": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
      }
    }
  }
}
