{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causal-presidents.local/schema/rag_corpus.schema.json",
  "title": "RAG corpus artifact (Stage 8)",
  "type": "object",
  "required": [
    "schema_version",
    "layer",
    "vintage",
    "generated_at",
    "generator",
    "registry",
    "chunking",
    "retrieval",
    "embedding",
    "source_hash_rule",
    "sources",
    "counts",
    "chunks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "layer": { "type": "string" },
    "vintage": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["script", "spec"],
      "properties": {
        "script": { "type": "string" },
        "spec": { "type": "string" },
        "git_sha": { "type": ["string", "null"] }
      }
    },
    "registry": {
      "type": "object",
      "required": ["index", "index_vintage"],
      "properties": {
        "index": { "type": "string" },
        "index_vintage": { "type": "string" },
        "card_estimate_counts": { "type": ["object", "null"] }
      }
    },
    "chunking": { "type": "object" },
    "retrieval": { "type": "object" },
    "embedding": {
      "type": "object",
      "required": ["status", "model", "dim"],
      "properties": {
        "status": { "enum": ["built", "not_built"] },
        "model": { "type": "string" },
        "dim": { "type": "integer", "minimum": 1 },
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "bytes": { "type": "integer" },
        "normalised": { "type": "boolean" },
        "metric": { "type": "string" },
        "n_chunk_vectors": { "type": "integer" },
        "n_query_vectors": { "type": "integer" },
        "questions_embedded": { "type": "integer" },
        "library": { "type": "object" }
      }
    },
    "source_hash_rule": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer" },
          "hash_rule": { "type": "string" }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["chunks", "by_doc_type", "chars"],
      "properties": {
        "chunks": { "type": "integer", "minimum": 1 },
        "by_doc_type": { "type": "object" },
        "chars": {
          "type": "object",
          "required": ["total", "max", "min"],
          "properties": {
            "total": { "type": "integer" },
            "max": { "type": "integer" },
            "min": { "type": "integer" }
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chunk_id", "doc_type", "title", "text", "vintage", "source", "citation", "metadata", "chars", "text_sha256"],
        "properties": {
          "chunk_id": { "type": "string", "minLength": 3 },
          "doc_type": {
            "enum": [
              "card_estimate",
              "model_card",
              "published_result",
              "methodology",
              "data_dictionary",
              "administration",
              "shock",
              "event_study",
              "coverage",
              "scope"
            ]
          },
          "title": { "type": "string" },
          "text": { "type": "string", "minLength": 60 },
          "vintage": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "source": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "anchor": { "type": ["string", "null"] },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "citation": { "type": "string" },
          "metadata": {
            "type": "object",
            "properties": {
              "part": { "type": "integer", "minimum": 1 },
              "n_parts": { "type": "integer", "minimum": 1 }
            }
          },
          "chars": { "type": "integer", "minimum": 1 },
          "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
