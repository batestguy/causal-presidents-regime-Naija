{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causal-presidents.local/schema/rag_eval.schema.json",
  "title": "RAG evaluation set (Stage 8)",
  "type": "object",
  "required": ["schema_version", "vintage", "generated_at", "generator", "corpus", "ragas", "counts", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "layer": { "type": "string" },
    "vintage": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["script", "spec"],
      "properties": {
        "script": { "type": "string" },
        "spec": { "type": "string" },
        "git_sha": { "type": ["string", "null"] }
      }
    },
    "corpus": { "type": "string" },
    "ragas": {
      "type": "object",
      "required": ["status", "why"],
      "properties": {
        "status": { "enum": ["not_run", "measured"] },
        "why": { "type": "string" },
        "metadata": { "type": "array", "items": { "type": "string" } }
      }
    },
    "counts": {
      "type": "object",
      "required": ["questions", "answerable", "refusal_with_reason", "out_of_scope"],
      "properties": {
        "questions": { "type": "integer", "minimum": 1 },
        "answerable": { "type": "integer", "minimum": 0 },
        "refusal_with_reason": { "type": "integer", "minimum": 0 },
        "out_of_scope": { "type": "integer", "minimum": 0 }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "question", "gold_refs", "gold_chunks", "must_contain", "reference_answer"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "type": { "enum": ["answerable", "refusal_with_reason", "out_of_scope"] },
          "question": { "type": "string", "minLength": 8 },
          "gold_refs": { "type": "array", "items": { "type": "string" } },
          "gold_chunks": { "type": "array", "items": { "type": "string" } },
          "must_contain": { "type": "array", "items": { "type": "string" } },
          "refusal_must_cite": { "type": ["string", "null"] },
          "reference_answer": { "type": "string" },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
