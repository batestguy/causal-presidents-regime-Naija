{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/causal-presidents-regime-Naija/registry/schema/dag_card.schema.json",
  "title": "Causal DAG card",
  "description": "One identification design instantiated for one outcome. The app reads these cards to let a visitor pick an outcome, pick a causal model, and see the assumption the estimate would rest on, together with the adjustment set the graph itself implies. A card carries no estimate until Stages 6-7 fill the estimate block.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dag_id",
    "schema_version",
    "vintage_date",
    "generated_at",
    "generator",
    "outcome",
    "design",
    "nodes",
    "edges",
    "adjustment_set",
    "adjustment_sets",
    "assumption_required",
    "identifying_assumption",
    "cannot_rule_out",
    "dagitty_full",
    "dagitty_assumed",
    "diagnostics",
    "assets",
    "estimate"
  ],
  "properties": {
    "dag_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+__(A|B|C)$",
      "description": "<outcome_id>__<design_id>"
    },
    "schema_version": { "type": "string" },
    "vintage_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "git_sha"],
      "properties": {
        "script": { "type": "string" },
        "git_sha": { "type": ["string", "null"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "short", "domain", "unit", "direction", "frequency", "source", "coverage_status"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "short": { "type": "string" },
        "domain": { "type": "string", "enum": ["health", "education", "security", "economy"] },
        "unit": { "type": "string" },
        "direction": { "type": "string", "enum": ["up", "down"], "description": "up = higher is better, down = lower is better" },
        "frequency": { "type": "string" },
        "source": { "type": "string" },
        "coverage_status": {
          "type": "string",
          "enum": ["ok", "partial", "declared_gap", "blocked"]
        },
        "coverage_note": { "type": "string" }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "short", "unit", "estimand", "estimator", "exposure_node", "outcome_node", "adjustment_criterion", "design_controls"],
      "properties": {
        "id": { "type": "string", "enum": ["A", "B", "C"] },
        "name": { "type": "string" },
        "short": { "type": "string" },
        "unit": { "type": "string" },
        "estimand": { "type": "string" },
        "estimator": { "type": "string" },
        "exposure_node": { "type": "string" },
        "outcome_node": { "type": "string" },
        "adjustment_criterion": { "type": "string", "enum": ["backdoor"] },
        "design_controls": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "short", "role", "observed", "source", "source_status"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "short": { "type": "string" },
          "role": { "type": "string", "enum": ["exposure", "outcome", "confounder", "mediator", "modifier"] },
          "observed": {
            "type": "boolean",
            "description": "false = a node the estimate requires to be absent; drawn on the graph, listed in assumption_required, and dropped from the graph used to compute the adjustment set"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Where this variable's data comes from (Stage 1 exit criterion: every variable maps to a named source or a declared gap)"
          },
          "source_status": {
            "type": "string",
            "enum": ["acquired", "gap", "derived", "construct", "unobserved"],
            "description": "acquired = a landing flow exists and the series has been pulled; gap = no usable source yet (recorded, never silently absent); derived = computed from other nodes; construct = a design artefact such as a fixed effect; unobserved = the node the estimate assumes absent"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "adjustment_set": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The minimal backdoor adjustment set, computed by dagitty on the assumed graph (unobserved nodes removed). Empty means no open backdoor path."
    },
    "adjustment_sets": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } },
      "description": "Every valid adjustment set dagitty returned, for transparency when more than one exists."
    },
    "assumption_required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Node ids the estimate requires to be absent (the identifying assumption in graph form)"
    },
    "identifying_assumption": { "type": "string", "minLength": 20 },
    "cannot_rule_out": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "dagitty_full": {
      "type": "string",
      "description": "The displayed graph as a dagitty DAG string, including unobserved nodes"
    },
    "dagitty_assumed": {
      "type": "string",
      "description": "The graph the adjustment set was computed from: unobserved nodes and their edges removed"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "blocker", "note", "coverage_status", "vintage", "source"],
      "description": "Stage 5 pre-analysis diagnostics for this (outcome, design) pair, attached by analysis/R/01_build_dags.R from registry/diagnostics/<vintage>/diagnostics.json. A card whose status is not `pass` must name the blocker: PHASES.md Stage 6 forbids a card rendered with a gap.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "degraded", "fail", "not_attempted"],
          "description": "pass = every pre-check passed; degraded = estimable but not as specified; fail = a pre-check failed, so this design is dropped for this outcome; not_attempted = the outcome has no usable series, so no pre-check could run"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "verdict", "detail"],
            "properties": {
              "id": { "type": "string" },
              "verdict": {
                "type": "string",
                "enum": ["pass", "computed", "flag", "inconclusive", "deviation", "fail", "not_run", "weak_fit"]
              },
              "detail": { "type": "string" }
            }
          }
        },
        "blocker": {
          "type": ["string", "null"],
          "description": "What stops this card passing. Required (non-null) whenever status is not `pass`."
        },
        "note": { "type": "string" },
        "coverage_status": {
          "type": "string",
          "enum": ["ok", "partial", "declared_gap", "blocked"]
        },
        "vintage": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source": { "type": "string" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["svg"],
      "properties": {
        "svg": { "type": "string" }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "model_card_ref", "the_number_is_for_this_card", "note"],
      "properties": {
        "status": { "type": "string", "enum": ["not_estimated", "estimated"] },
        "model_card_ref": { "type": ["string", "null"] },
        "the_number_is_for_this_card": {
          "type": "boolean",
          "description": "True only when the attached specification is about this card's own outcome. The registry never publishes a number that fails this test; the field exists so that if it ever did, the app and the verifier would both see it as false rather than as a number"
        },
        "specification": {
          "type": "object",
          "description": "Copied field for field from the estimates artifact named in `artifact`. Present iff status is `estimated`",
          "required": ["artifact", "spec_index", "design", "outcome", "coefficient_name", "coefficient", "standard_error", "ci_low", "ci_high", "n_obs"],
          "properties": {
            "artifact": { "type": "string" },
            "spec_index": { "type": "integer", "minimum": 1 },
            "design": { "type": "string", "enum": ["A", "B"] },
            "outcome": { "type": "string" },
            "coefficient_name": { "type": "string" },
            "coefficient": { "type": "number" },
            "standard_error": { "type": "number", "minimum": 0 },
            "ci_low": { "type": "number" },
            "ci_high": { "type": "number" },
            "p_value": { "type": "number" },
            "n_obs": { "type": "integer", "minimum": 1 },
            "n_units": { "type": "integer", "minimum": 1 },
            "first_month": { "type": "string" },
            "last_month": { "type": "string" },
            "estimator": { "type": "string" },
            "formula": { "type": "string" },
            "covariance": { "type": "string" }
          }
        },
        "verdict": {
          "type": "object",
          "description": "The Stage 6 verdict for this card's design, with the check that decided it. An estimate can be published on a card whose pre-check failed: both statements travel together",
          "required": ["status", "rule"],
          "properties": {
            "status": { "type": "string" },
            "rule": { "type": "string" },
            "failed_checks": { "type": ["string", "null"] },
            "checked_at": { "type": "object" }
          }
        },
        "robustness": {
          "type": "object",
          "description": "Stage 7's summary for this card's own axis level, so 'this number is one cell of a grid' travels with the number (Stage 8, S8-03)",
          "required": ["artifact", "axis", "axis_level", "design_support", "near_zero_band"],
          "properties": {
            "artifact": { "type": "string" },
            "axis": { "type": "string" },
            "preferred_specification": { "type": "string" },
            "this_specification_is_the_preferred_one": { "type": "boolean" },
            "axis_level": { "type": "object" },
            "design_support": { "type": "object" },
            "design_flip_levels": { "type": "integer", "minimum": 0 },
            "near_zero_band": { "type": "number", "minimum": 0 },
            "rule": { "type": "string" }
          }
        },
        "not_estimated_reason": {
          "type": "object",
          "description": "Present iff status is `not_estimated`: a closed set of reasons, so 'no estimate' is never silent",
          "required": ["code", "detail"],
          "properties": {
            "code": {
              "type": "string",
              "enum": ["outcome_series_absent", "no_specification_declared", "design_result_is_channel_level", "design_not_run"]
            },
            "detail": { "type": "string", "minLength": 20 }
          }
        },
        "published_result": { "type": ["string", "null"] },
        "note": { "type": "string", "minLength": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "estimated" } }, "required": ["status"] },
          "then": {
            "required": ["specification", "verdict", "robustness"],
            "properties": { "the_number_is_for_this_card": { "const": true } }
          },
          "else": { "required": ["not_estimated_reason"] }
        }
      ],
      "description": "Filled by analysis/R/05_registry.R (Stage 8) from the Stage 6 and Stage 7 artifacts. While status is not_estimated the app must show the assumption and the adjustment set with no number, and must say why."
    }
  }
}
