{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causal-presidents.local/schema/answer_eval.schema.json",
  "title": "Answer layer evaluation (Stage 9)",
  "type": "object",
  "required": [
    "schema_version",
    "vintage",
    "generated_at",
    "generator",
    "corpus",
    "gate",
    "contract",
    "sets",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "layer": { "type": "string" },
    "vintage": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["script", "spec", "gate_spec"],
      "properties": {
        "script": { "type": "string" },
        "spec": { "type": "string" },
        "gate_spec": { "type": "string" },
        "git_sha": { "type": ["string", "null"] }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["path", "sha256", "chunks"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "chunks": { "type": "integer", "minimum": 1 }
      }
    },
    "gate": {
      "type": "object",
      "required": ["path", "sha256", "artifact", "artifact_sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifact": { "type": "string" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contract": {
      "type": "object",
      "required": ["path", "sha256", "post_check", "refusal_template"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "version": { "type": ["integer", "null"] },
        "post_check": { "type": "string" },
        "refusal_template": { "type": "string" },
        "shapes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "requires": { "type": "array", "items": { "type": "string" } },
              "forbids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "retrieval": { "type": "string" }
      }
    },
    "sets": {
      "type": "object",
      "required": ["published", "held_out", "all"],
      "properties": {
        "published": { "$ref": "#/$defs/set" },
        "held_out": { "$ref": "#/$defs/set" },
        "all": { "$ref": "#/$defs/set" }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "set": {
      "type": "object",
      "required": [
        "n",
        "answered",
        "refused",
        "declined",
        "answer_rate",
        "answered_with_all_parts",
        "parts_present",
        "shapes",
        "refusals_with_citation",
        "declined_with_citation",
        "refusals_with_a_code",
        "answers_quoting_numbers_absent_from_the_citation",
        "answered_with_plain_language",
        "answers_whose_plain_reading_quotes_uncited_numbers",
        "questions_with_needles",
        "questions_whose_needles_are_all_satisfied",
        "needle_satisfaction",
        "needles_total",
        "needles_satisfied",
        "needle_recall"
      ],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "answered": { "type": "integer", "minimum": 0 },
        "refused": { "type": "integer", "minimum": 0 },
        "declined": { "type": "integer", "minimum": 0 },
        "answer_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "answered_with_all_parts": { "type": "integer", "minimum": 0 },
        "parts_present": {
          "type": "object",
          "required": ["interval", "reason_code", "identifying_assumption", "cannot_rule_out", "citation"],
          "properties": {
            "interval": { "type": "integer", "minimum": 0 },
            "reason_code": { "type": "integer", "minimum": 0 },
            "identifying_assumption": { "type": "integer", "minimum": 0 },
            "cannot_rule_out": { "type": "integer", "minimum": 0 },
            "citation": { "type": "integer", "minimum": 0 }
          }
        },
        "shapes": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "refusals_with_citation": { "type": "integer", "minimum": 0 },
        "declined_with_citation": { "type": "integer", "minimum": 0 },
        "refusals_with_a_code": { "type": "integer", "minimum": 0 },
        "answers_quoting_numbers_absent_from_the_citation": { "type": "integer", "minimum": 0 },
        "answered_with_plain_language": { "type": "integer", "minimum": 0 },
        "answers_whose_plain_reading_quotes_uncited_numbers": { "type": "integer", "minimum": 0 },
        "questions_with_needles": { "type": "integer", "minimum": 0 },
        "questions_whose_needles_are_all_satisfied": { "type": "integer", "minimum": 0 },
        "needle_satisfaction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "needles_total": { "type": "integer", "minimum": 0 },
        "needles_satisfied": { "type": "integer", "minimum": 0 },
        "needle_recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "set",
        "question",
        "expected_intent",
        "intent",
        "status",
        "shape",
        "refusal_code",
        "check",
        "citation",
        "chunks_used",
        "needles",
        "numbers_quoted",
        "numbers_absent_from_citation",
        "plain_numbers_absent_from_citation",
        "text",
        "plain"
      ],
      "properties": {
        "id": { "type": "string" },
        "set": { "enum": ["published", "held_out"] },
        "question": { "type": "string" },
        "expected_intent": { "enum": ["answerable", "out_of_scope", "refusal_with_reason"] },
        "intent": { "enum": ["answerable", "out_of_scope", "refusal_with_reason"] },
        "rule_id": { "type": ["string", "null"] },
        "route": { "type": ["string", "null"] },
        "status": { "enum": ["answered", "refused", "declined"] },
        "shape": { "type": ["string", "null"] },
        "refusal_code": { "type": ["string", "null"] },
        "check": {
          "type": "object",
          "properties": {
            "interval": { "type": "boolean" },
            "reason_code": { "type": "boolean" },
            "identifying_assumption": { "type": "boolean" },
            "cannot_rule_out": { "type": "boolean" },
            "citation": { "type": "boolean" },
            "cited": { "type": "boolean" },
            "retrieved": { "type": "integer", "minimum": 0 },
            "quote": { "type": "string" }
          }
        },
        "citation": { "type": ["string", "null"] },
        "chunks_used": { "type": "array", "items": { "type": "string" } },
        "needles": {
          "type": "object",
          "required": ["required", "satisfied", "missing", "all_satisfied"],
          "properties": {
            "required": { "type": "array", "items": { "type": "string" } },
            "satisfied": { "type": "array", "items": { "type": "string" } },
            "missing": { "type": "array", "items": { "type": "string" } },
            "all_satisfied": { "type": "boolean" }
          }
        },
        "numbers_quoted": { "type": "array", "items": { "type": "string" } },
        "numbers_absent_from_citation": { "type": "array", "items": { "type": "string" } },
        "plain_numbers_absent_from_citation": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "plain": {
          "type": "object",
          "required": ["headline", "terms", "text"],
          "properties": {
            "headline": { "type": "string" },
            "reading": {"type": ["object", "null"]},
            "terms": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["term", "meaning"],
                "properties": {
                  "term": { "type": "string" },
                  "meaning": { "type": "string" }
                }
              }
            },
            "text": { "type": "string" }
          }
        }
      }
    }
  }
}
