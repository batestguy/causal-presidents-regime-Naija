{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causal-presidents.local/schema/answer_eval.schema.json",
  "title": "Answer layer evaluation (Stage 9)",
  "type": "object",
  "required": [
    "schema_version",
    "vintage",
    "generated_at",
    "generator",
    "corpus",
    "gate",
    "contract",
    "sets",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "layer": { "type": "string" },
    "vintage": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["script", "spec", "gate_spec"],
      "properties": {
        "script": { "type": "string" },
        "spec": { "type": "string" },
        "gate_spec": { "type": "string" },
        "git_sha": { "type": ["string", "null"] }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["path", "sha256", "chunks"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "chunks": { "type": "integer", "minimum": 1 }
      }
    },
    "gate": {
      "type": "object",
      "required": ["path", "sha256", "artifact", "artifact_sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifact": { "type": "string" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contract": {
      "type": "object",
      "required": ["path", "sha256", "post_check", "refusal_template"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "post_check": { "type": "string" },
        "refusal_template": { "type": "string" },
        "retrieval": { "type": "string" }
      }
    },
    "sets": {
      "type": "object",
      "required": ["published", "held_out", "all"],
      "properties": {
        "published": { "$ref": "#/$defs/set" },
        "held_out": { "$ref": "#/$defs/set" },
        "all": { "$ref": "#/$defs/set" }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "set": {
      "type": "object",
      "required": [
        "n",
        "answered",
        "refused",
        "declined",
        "answer_rate",
        "answered_with_all_parts",
        "parts_present",
        "refusals_with_citation",
        "declined_with_citation",
        "answers_quoting_numbers_absent_from_the_citation"
      ],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "answered": { "type": "integer", "minimum": 0 },
        "refused": { "type": "integer", "minimum": 0 },
        "declined": { "type": "integer", "minimum": 0 },
        "answer_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "answered_with_all_parts": { "type": "integer", "minimum": 0 },
        "parts_present": {
          "type": "object",
          "required": ["interval", "assumption", "cannot_rule_out", "citation"],
          "properties": {
            "interval": { "type": "integer", "minimum": 0 },
            "assumption": { "type": "integer", "minimum": 0 },
            "cannot_rule_out": { "type": "integer", "minimum": 0 },
            "citation": { "type": "integer", "minimum": 0 }
          }
        },
        "refusals_with_citation": { "type": "integer", "minimum": 0 },
        "declined_with_citation": { "type": "integer", "minimum": 0 },
        "answers_quoting_numbers_absent_from_the_citation": { "type": "integer", "minimum": 0 }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "set",
        "question",
        "expected_intent",
        "intent",
        "status",
        "check",
        "citation",
        "chunks_used",
        "numbers_quoted",
        "numbers_absent_from_citation",
        "text"
      ],
      "properties": {
        "id": { "type": "string" },
        "set": { "enum": ["published", "held_out"] },
        "question": { "type": "string" },
        "expected_intent": { "enum": ["answerable", "out_of_scope", "refusal_with_reason"] },
        "intent": { "enum": ["answerable", "out_of_scope", "refusal_with_reason"] },
        "rule_id": { "type": ["string", "null"] },
        "route": { "type": ["string", "null"] },
        "status": { "enum": ["answered", "refused", "declined"] },
        "check": {
          "type": "object",
          "properties": {
            "interval": { "type": "boolean" },
            "assumption": { "type": "boolean" },
            "cannot_rule_out": { "type": "boolean" },
            "citation": { "type": "boolean" },
            "cited": { "type": "boolean" },
            "retrieved": { "type": "integer", "minimum": 0 },
            "quote": { "type": "string" }
          }
        },
        "citation": { "type": ["string", "null"] },
        "chunks_used": { "type": "array", "items": { "type": "string" } },
        "numbers_quoted": { "type": "array", "items": { "type": "string" } },
        "numbers_absent_from_citation": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" }
      }
    }
  }
}
