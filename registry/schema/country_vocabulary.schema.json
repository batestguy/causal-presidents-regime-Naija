{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/causal-presidents-regime-Naija/registry/schema/country_vocabulary.schema.json",
  "title": "Causal Presidents — committed country-name vocabulary for the intent gate",
  "description": "ISO 3166-1 country names and a short alias list, committed so the gate's country rule behaves the same on a fresh clone. Schema version 1 (2026-10-22).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layer",
    "generated_at",
    "generator",
    "source",
    "excluded_from_refusal",
    "counts",
    "countries"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "layer": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "required": ["script"],
      "properties": {
        "script": {"type": "string", "minLength": 1},
        "pycountry": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "version", "why"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1}
      }
    },
    "excluded_from_refusal": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["iso3", "name", "why"],
        "properties": {
          "iso3": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["countries"],
      "properties": {"countries": {"type": "integer", "minimum": 1}}
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iso3", "iso2", "name", "aliases"],
        "properties": {
          "iso3": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "name": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
