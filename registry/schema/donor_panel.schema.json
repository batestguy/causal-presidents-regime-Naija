{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/causal-presidents-regime-Naija/registry/schema/donor_panel.schema.json",
  "title": "Causal Presidents — donor-panel membership (the gate's KG01 justification)",
  "description": "The 99-country candidate set Stage 5 screened, committed so the intent gate's country rule is reproducible on a fresh clone. Schema version 1 (2026-10-22).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "layer", "vintage", "generated_at", "generator", "counts", "members"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "layer": {"type": "string", "minLength": 1},
    "vintage": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generated_at": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "required": ["script", "source", "source_sha256"],
      "properties": {
        "script": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["members"],
      "properties": {"members": {"type": "integer", "minimum": 1}}
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iso2", "iso3", "name"],
        "properties": {
          "iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "iso3": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "name": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
