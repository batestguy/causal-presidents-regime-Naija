{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/causal-presidents-regime-Naija/registry/schema/dag_index.schema.json",
  "title": "Causal DAG registry index",
  "$defs": {
    "designResult": {
      "type": "object",
      "required": ["design", "status", "verdict", "result_is_card_level", "specifications", "artifacts"],
      "properties": {
        "design": { "type": "string", "enum": ["A", "B", "C"] },
        "status": { "type": "string" },
        "verdict": { "type": "object" },
        "result_is_card_level": {
          "type": "boolean",
          "description": "False means the published result is not about any one card's outcome (Design B: the national FAAC channel; Design C: a synthetic control whose gap has no interval to put on a card)"
        },
        "result_outcome": { "type": "string" },
        "cards_that_carry_no_number": { "type": "integer", "minimum": 0 },
        "why": { "type": ["string", "null"], "description": "the reason a design was not run; null once it has been run" },
        "next_step": { "type": ["string", "null"] },
        "artifact": { "type": ["string", "null"], "description": "the design's own artifact, where a design that publishes more than a coefficient keeps its numbers" },
        "counts": { "type": ["object", "null"] },
        "windows": { "type": "array" },
        "specifications": { "type": "array" },
        "specifications_without_a_card": { "type": "array" },
        "robustness": { "type": "object" },
        "artifacts": { "type": "object" }
      }
    }
  },
  "description": "The matrix the app reads first: which outcomes exist, which identification designs exist, and one entry per (outcome, design) DAG. Also carries the honest gap list — every variable a design needs that has no usable source yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layer",
    "vintage_date",
    "generated_at",
    "generator",
    "counts",
    "diagnostics",
    "registry",
    "estimates",
    "published_results",
    "designs",
    "outcomes",
    "dags",
    "variables_still_missing"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "layer": { "type": "string" },
    "vintage_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "git_sha"],
      "properties": {
        "script": { "type": "string" },
        "git_sha": { "type": ["string", "null"] }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomes", "designs", "dags"],
      "properties": {
        "outcomes": { "type": "integer", "minimum": 1 },
        "designs": { "type": "integer", "minimum": 1 },
        "dags": { "type": "integer", "minimum": 1 }
      }
    },
    "designs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "short", "unit", "estimand"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "short": { "type": "string" },
          "unit": { "type": "string" },
          "estimand": { "type": "string" }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "domain", "direction", "coverage_status"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "domain": { "type": "string", "enum": ["health", "education", "security", "economy"] },
          "direction": { "type": "string", "enum": ["up", "down"] },
          "coverage_status": { "type": "string", "enum": ["ok", "partial", "declared_gap", "blocked"] }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vintage", "source", "spec", "design_verdicts", "status_counts"],
      "description": "Stage 5's answer, carried on the index so the app can report which causal models survive their pre-checks without reading 36 cards. The per-card detail stays on the cards. Added in schema 0.2.0.",
      "properties": {
        "vintage": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source": { "type": "string" },
        "spec": { "type": "string" },
        "design_verdicts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "required": ["design_id", "status"],
            "properties": {
              "design_id": { "type": "string", "enum": ["A", "B", "C"] },
              "status": {
                "type": "string",
                "enum": ["candidate", "degraded", "dropped", "infeasible", "not_attempted"]
              }
            }
          }
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "How many of the 36 cards carry each pre-check status"
        }
      }
    },
    "registry": {
      "type": "object",
      "description": "Stage 8: what the app's data contract is, and how many cards carry a published number (added 2026-10-18, schema 0.3.0)",
      "required": ["generated_at", "generated_by", "spec", "rule", "card_estimate_counts", "card_wins"],
      "properties": {
        "generated_at": { "type": "string" },
        "generated_by": { "type": "string" },
        "spec": { "type": "string" },
        "rule": { "type": "string" },
        "card_estimate_counts": {
          "type": "object",
          "required": ["estimated", "not_estimated", "not_estimated_by_reason"],
          "properties": {
            "estimated": { "type": "integer", "minimum": 0 },
            "not_estimated": { "type": "integer", "minimum": 0 },
            "not_estimated_by_reason": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "card_wins": { "type": "string" }
      }
    },
    "estimates": {
      "type": "object",
      "required": ["artifact", "vintage", "design_status"],
      "properties": {
        "artifact": { "type": "string" },
        "vintage": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "design_status": {
          "type": "object",
          "required": ["A", "B", "C"],
          "properties": {
            "A": { "type": "string" },
            "B": { "type": "string" },
            "C": { "type": "string" }
          }
        }
      }
    },
    "published_results": {
      "type": "object",
      "description": "One entry per design that reached a verdict. Design B's result is channel-level, which is why no B card carries a number; the field says so explicitly",
      "required": ["A", "B", "C"],
      "properties": {
        "A": { "$ref": "#/$defs/designResult" },
        "B": { "$ref": "#/$defs/designResult" },
        "C": { "$ref": "#/$defs/designResult" }
      }
    },
    "dags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dag_id", "outcome_id", "design_id", "svg", "adjustment_set", "assumption_required", "diagnostics_status", "diagnostics_blocker"],
        "properties": {
          "dag_id": { "type": "string", "pattern": "^[a-z0-9_]+__(A|B|C)$" },
          "outcome_id": { "type": "string" },
          "design_id": { "type": "string", "enum": ["A", "B", "C"] },
          "svg": { "type": "string" },
          "adjustment_set": { "type": "array", "items": { "type": "string" } },
          "assumption_required": { "type": "array", "items": { "type": "string" } },
          "diagnostics_status": {
            "type": "string",
            "enum": ["pass", "degraded", "fail", "not_attempted"]
          },
          "diagnostics_blocker": { "type": ["string", "null"] }
        }
      }
    },
    "variables_still_missing": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Every node whose source_status is 'gap' across the whole registry — the honest answer to 'what are we missing', machine-readable"
    }
  }
}
