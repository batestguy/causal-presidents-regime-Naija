{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causal-presidents.local/schema/rag_retrieval.schema.json",
  "title": "RAG retrieval evaluation (Stage 8)",
  "type": "object",
  "required": [
    "schema_version",
    "vintage",
    "generated_at",
    "generator",
    "corpus",
    "eval_set",
    "k",
    "retrievers",
    "refusal",
    "metrics",
    "gates",
    "answer_shape",
    "ragas",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "layer": { "type": "string" },
    "vintage": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["script", "spec"],
      "properties": {
        "script": { "type": "string" },
        "spec": { "type": "string" },
        "git_sha": { "type": ["string", "null"] }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["path", "sha256", "chunks", "vintage"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "chunks": { "type": "integer" },
        "vintage": { "type": "string" }
      }
    },
    "eval_set": {
      "type": "object",
      "required": ["path", "sha256", "counts"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "counts": { "type": "object" }
      }
    },
    "k": { "type": "integer", "minimum": 2 },
    "retrievers": {
      "type": "object",
      "required": ["embedding", "bm25"],
      "properties": {
        "embedding": { "type": "object", "required": ["status"] },
        "bm25": { "type": "object", "required": ["status"] }
      }
    },
    "refusal": {
      "type": "object",
      "required": ["rule", "threshold", "applies_to", "caveat"],
      "properties": {
        "rule": { "type": ["object", "string"] },
        "threshold": { "type": ["number", "null"] },
        "median_answerable_top1": { "type": ["number", "null"] },
        "applies_to": { "type": "string" },
        "caveat": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["embedding", "bm25"],
      "properties": {
        "embedding": { "type": ["object", "null"] },
        "bm25": { "type": ["object", "null"] }
      }
    },
    "gates": {
      "type": "object",
      "required": ["embedding", "bm25"],
      "properties": {
        "embedding": { "type": "object" },
        "bm25": { "type": "object" }
      }
    },
    "answer_shape": {
      "type": "object",
      "required": ["status", "why"],
      "properties": {
        "status": { "enum": ["not_measured", "measured"] },
        "why": { "type": "string" },
        "declared_in": { "type": "array" }
      }
    },
    "ragas": { "type": "object", "required": ["status", "why"] },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "retrieved", "top1_score", "first_gold_rank"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "retrieved": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chunk_id", "score"],
              "properties": {
                "chunk_id": { "type": "string" },
                "score": { "type": "number" }
              }
            }
          },
          "top1_score": { "type": "number" },
          "first_gold_rank": { "type": ["integer", "null"] },
          "refused": { "type": ["boolean", "null"] },
          "bm25": { "type": "object" },
          "embedding": { "type": "object" }
        }
      }
    }
  }
}
